# Public frontend configuration only.
# Do not place passwords, API secrets, database credentials, service-role keys,
# access tokens, cookies, OTPs, recovery codes, private addresses, or other
# personal data in this file.
#
# IMPORTANT: every NEXT_PUBLIC_* value is compiled into browser-visible code.
# Only put values here that you intentionally want public.

NEXT_PUBLIC_SITE_URL=https://flythebg.com
NEXT_PUBLIC_APP_NAME=FlytheBG
NEXT_PUBLIC_UPLOAD_MAX_MB=12
NEXT_PUBLIC_CONTACT_EMAIL=

# Monetag configuration.
NEXT_PUBLIC_MONETAG_ENABLED=true
# Paste the exact HTTPS ad-channel tag URL supplied by Monetag, if your zone uses one.
NEXT_PUBLIC_MONETAG_SCRIPT_SRC=
# Optional verification meta tag values supplied by Monetag.
NEXT_PUBLIC_MONETAG_VERIFICATION_META_NAME=
NEXT_PUBLIC_MONETAG_VERIFICATION_META_CONTENT=
# Public zone IDs for the corresponding Monetag placements.
NEXT_PUBLIC_MONETAG_ZONE_LANDING=
NEXT_PUBLIC_MONETAG_ZONE_REMOVE_BG=
NEXT_PUBLIC_MONETAG_ZONE_PASSPORT=
NEXT_PUBLIC_MONETAG_ZONE_FAQ=

# Optional Monetag seller lines supplied by Monetag for the generated ads.txt.
# This value is published in /ads.txt and is not a secret.
MONETAG_ADS_TXT_LINES=

NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
