# ==============================
# FlytheBG web (public variables)
# ==============================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=FlytheBG
NEXT_PUBLIC_UPLOAD_MAX_MB=12
GOOGLE_SITE_VERIFICATION=

# Optional Google AdSense. Leave blank until your site is approved.
# Example format only: ca-pub-1234567890123456
NEXT_PUBLIC_ADSENSE_CLIENT=

# ==============================
# FlytheBG web (server-only)
# ==============================
INFERENCE_SERVICE_URL=http://localhost:8000
INFERENCE_API_SECRET=replace-with-a-long-random-secret
UPLOAD_MAX_MB=12
INFERENCE_TIMEOUT_MS=180000
RATE_LIMIT_ANONYMOUS=30
RATE_LIMIT_WINDOW_SECONDS=600

# ==============================
# Operator / legal contact
# ==============================
# A registered company is NOT required by the app. Fill only details that are true.
COMPANY_LEGAL_NAME=
COMPANY_TRADING_NAME=FlytheBG
COMPANY_REGISTRATION_NUMBER=
COMPANY_REGISTERED_ADDRESS=
COMPANY_COUNTRY=
CONTACT_EMAIL=stackpilotfe@outlook.com
LEGAL_EMAIL=stackpilotfe@outlook.com

# ==============================
# Private inference service
# ==============================
MODEL_PROVIDER=isnet_precision
MODEL_VARIANT=general-use-precision
MODEL_DIR=./.models
DATABASE_URL=
ONNX_INTRA_OP_THREADS=1
MAX_IMAGE_PIXELS=40000000
INFERENCE_CONCURRENCY=1
PORT=8000
