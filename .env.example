# Public frontend configuration only.
# Do not place passwords, API secrets, database credentials, service-role keys,
# access tokens, cookies, OTPs, recovery codes, private addresses, or other
# personal data in this file.
# IMPORTANT: every NEXT_PUBLIC_* value is compiled into browser-visible code.
# Only put values here that you intentionally want public.

NEXT_PUBLIC_SITE_URL=https://flythebg.com
NEXT_PUBLIC_APP_NAME=FlytheBG
NEXT_PUBLIC_UPLOAD_MAX_MB=12
NEXT_PUBLIC_CONTACT_EMAIL=

# Google AdSense.
NEXT_PUBLIC_ADSENSE_ENABLED=true
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-7486274445029717
NEXT_PUBLIC_ADSENSE_SLOT_LANDING=
NEXT_PUBLIC_ADSENSE_SLOT_REMOVE_BG=
NEXT_PUBLIC_ADSENSE_SLOT_PASSPORT=
NEXT_PUBLIC_ADSENSE_SLOT_FAQ=

# Monetag.
# Keep the current MultiTag disabled while AdSense is enabled unless Monetag confirms
# that the selected format is compatible with AdSense and does not use pop-under/OnClick.
NEXT_PUBLIC_MONETAG_ENABLED=true
NEXT_PUBLIC_MONETAG_ADSENSE_SAFE=false
NEXT_PUBLIC_MONETAG_SCRIPT_SRC=https://quge5.com/88/tag.min.js
NEXT_PUBLIC_MONETAG_VERIFICATION_META_NAME=monetag
NEXT_PUBLIC_MONETAG_VERIFICATION_META_CONTENT=5e777e0aa6ce027ca2e1a8ec1c8325b3
NEXT_PUBLIC_MONETAG_ZONE_LANDING=
NEXT_PUBLIC_MONETAG_ZONE_REMOVE_BG=
NEXT_PUBLIC_MONETAG_ZONE_PASSPORT=
NEXT_PUBLIC_MONETAG_ZONE_FAQ=

# Optional Monetag seller lines supplied by Monetag for /ads.txt.
MONETAG_ADS_TXT_LINES=

NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
